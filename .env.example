# ============================================
# ZELCOR - UNIFIED ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env in root and update values

# ===================
# SUPABASE (Database & Auth)
# ===================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===================
# OPENAI (AI Classification)
# ===================
OPENAI_API_KEY=sk-your-openai-api-key

# ===================
# ETHEREUM SEPOLIA (Blockchain)
# ===================
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-project-id
PRIVATE_KEY=your-wallet-private-key (without 0x prefix)
ETHERSCAN_API_KEY=your-etherscan-api-key

# ===================
# SMART CONTRACT
# ===================
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ===================
# BACKEND SERVER
# ===================
PORT=3000
NODE_ENV=development

# ===================
# FRONTEND (Website)
# ===================
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===================
# MOBILE (Flutter)
# ===================
# These will be used in Flutter app
FLUTTER_API_BASE_URL=http://localhost:3000
FLUTTER_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id